# Local settings read by the application. Cloud settings live in GitHub
# Environments; see README.md.
APP_ENV=development
APP_VERSION=dev
PORT=8000

# Database (optional): `docker compose up` runs PostgreSQL and these settings.
# docs/database.md lists every DB_* setting and how each cloud signs in.
# DB_AUTH=password
# DB_HOST=127.0.0.1
# DB_NAME=app
# DB_USER=app_user
# DB_PASSWORD=app-local-password
# DB_SSLMODE=disable
